# Rebuild the changed shared policy and frontend on the exact upstream runtime.
FROM node:24-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY client/package.json ./client/
RUN npm ci --workspace=shared --workspace=client
COPY shared ./shared
RUN npm run test --workspace=shared -- src/auth/password-policy.spec.ts
RUN npm run build --workspace=shared
COPY client ./client
ARG APP_VERSION=5.0.0-selfhost.1
RUN npm run test --workspace=client -- src/components/shared/PasswordChecklist.test.tsx src/pages/login/useLogin.test.tsx src/pages/resetPassword/useResetPassword.test.ts src/pages/LoginPage.test.tsx src/components/Settings/AccountTab.test.tsx
RUN npm run build --workspace=client

FROM mauriceboe/trek:5.0.0@sha256:0c0a8f5b488fc2967248695e04bb000bb177d0b63d3385089d33dca6fde4daf9
COPY --chown=node:node --from=builder /app/shared/dist ./shared/dist
COPY --chown=node:node --from=builder /app/client/dist ./server/public
COPY --chown=node:node wiki ./wiki
ARG APP_VERSION=5.0.0-selfhost.1
RUN printf '%s\n' "$APP_VERSION" > /app/server/VERSION
LABEL org.opencontainers.image.source="https://github.com/caidenlemiha/TREK"
